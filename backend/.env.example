# ===== Server =====
PORT=4000
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ===== Database (Render Postgres connection string) =====
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===== Auth =====
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
REQUIRE_EWU_EMAIL=false
# REQUIRE_EWU_EMAIL=true restricts registration to @ewubd.edu addresses

# ===== Seed (used by `npm run seed`) =====
SEED_ADMIN_EMAIL=admin@ewu.edu.bd
SEED_ADMIN_PASSWORD=ChangeMe123!

# ===== Email (OTP verification) — optional; without these, OTPs are logged to console =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Smart Study Exchange <no-reply@smartstudyexchange.app>"

# ===== Cloudinary (file storage: book images, note PDFs, chat attachments) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== AI (xAI Grok API) =====
# Get a key at https://console.x.ai
GROK_API_KEY=
GROK_MODEL=grok-3-mini
# Note: semantic search embeddings are not available via Grok — smart search
# automatically falls back to Postgres keyword search when embeddings fail.

# ===== YouTube (optional; without it, video titles fall back to a generic label) =====
YOUTUBE_API_KEY=

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=
